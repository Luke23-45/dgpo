<actuator>
    <!-- The gainprm (P-gain) has been significantly reduced for smoother motion. -->
    <!-- The biasprm (D-gain) is set to a standard critical damping value. -->
    <general class="panda" name="actuator1" joint="joint1" gainprm="600" biasprm="0 -600 -40"/>
    <general class="panda" name="actuator2" joint="joint2" gainprm="600" biasprm="0 -600 -40" ctrlrange="-1.7628 1.7628"/>
    <general class="panda" name="actuator3" joint="joint3" gainprm="600" biasprm="0 -600 -40"/>
    <general class="panda" name="actuator4" joint="joint4" gainprm="600" biasprm="0 -600 -40" ctrlrange="-3.0718 -0.0698"/>
    <general class="panda" name="actuator5" joint="joint5" gainprm="400" biasprm="0 -400 -20" forcerange="-12 12"/>
    <general class="panda" name="actuator6" joint="joint6" gainprm="400" biasprm="0 -400 -20" forcerange="-12 12" ctrlrange="-0.0175 3.7525"/>
    <general class="panda" name="actuator7" joint="joint7" gainprm="400" biasprm="0 -400 -20" forcerange="-12 12"/>
    
    <!-- Gripper actuator can remain the same -->
    <general class="panda" name="actuator8" tendon="split" forcerange="-100 100" ctrlrange="0 255"
    gainprm="0.01568627451 0 0" biasprm="0 -100 -10"/>
</actuator>